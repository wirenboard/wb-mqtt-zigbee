#!/bin/sh
set -e

LEGACY_CONFIG="/usr/lib/wb-mqtt-zigbee/configs/wb-mqtt-zigbee.conf"
CONFIG="/etc/wb-mqtt-zigbee.conf"
MIGRATION_DIR="/var/lib/wb-mqtt-zigbee"
MIGRATION_CONFIG="$MIGRATION_DIR/wb-mqtt-zigbee.conf.migrate"

if [ -f "$LEGACY_CONFIG" ] && [ ! -e "$CONFIG" ]; then
    install -d -m 0755 "$MIGRATION_DIR"
    cp -p "$LEGACY_CONFIG" "$MIGRATION_CONFIG"
fi

#DEBHELPER#
