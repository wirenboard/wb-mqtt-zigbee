{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "title": "Zigbee2MQTT bridge configuration",
  "configFile": {
    "path": "/etc/wb-mqtt-zigbee.conf",
    "service": "wb-mqtt-zigbee"
  },
  "properties": {
    "broker_url": {
      "type": "string",
      "title": "MQTT broker URL",
      "minLength": 1,
      "default": "unix:///var/run/mosquitto/mosquitto.sock"
    },
    "zigbee2mqtt_base_topic": {
      "type": "string",
      "title": "Zigbee2MQTT base topic",
      "minLength": 1,
      "pattern": "^[^+#\\s]+(?:/[^+#\\s]+)*$",
      "default": "zigbee2mqtt"
    },
    "device_id": {
      "type": "string",
      "title": "Bridge device ID",
      "minLength": 1,
      "pattern": "^[^/+#]+$",
      "default": "zigbee2mqtt"
    },
    "device_name": {
      "type": "string",
      "title": "Bridge device name",
      "minLength": 1,
      "default": "Zigbee2MQTT"
    },
    "bridge_log_min_level": {
      "type": "string",
      "title": "Minimum Zigbee2MQTT log level",
      "enum": ["debug", "info", "warning", "error"],
      "default": "warning"
    },
    "command_debounce_sec": {
      "type": "number",
      "title": "Command debounce time, seconds",
      "minimum": 0,
      "default": 5.0
    }
  },
  "required": ["broker_url", "zigbee2mqtt_base_topic"],
  "additionalProperties": false
}
